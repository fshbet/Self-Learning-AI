{"$id":"urn:knowledge-platform:export:1.5:documents","$schema":"https://json-schema.org/draft/2020-12/schema","description":"Document-level provenance and integrity metadata (schema 1.5) — never the document text.\n\nLets a consumer check, without the database, that every evidence record points at a known fetch of a known\nsource, that ``evidence.document_hash`` names the fetched version it was verified against (``content_hash`` now,\nor ``previous_content_hash`` before the last change), and — if they fetch the page themselves — that the raw\nbytes still hash to ``raw_sha256``. ``content_hash`` is computed by ``normalizer_version`` over the extracted\nmain text; the text itself is not exported because source terms may not allow redistribution.","properties":{"byte_size":{"default":0,"title":"Byte Size","type":"integer"},"canonical_url":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Canonical Url"},"content_changed_at":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Content Changed At"},"content_hash":{"title":"Content Hash","type":"string"},"depth":{"default":0,"title":"Depth","type":"integer"},"fetched_at":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Fetched At"},"final_url":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Final Url"},"http_etag":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Http Etag"},"http_last_modified":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Http Last Modified"},"id":{"title":"Id","type":"string"},"language":{"default":"en","title":"Language","type":"string"},"mirror_of_document_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Mirror Of Document Id"},"normalizer_version":{"title":"Normalizer Version","type":"string"},"previous_content_hash":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Previous Content Hash"},"published_at":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Published At"},"raw_sha256":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Raw Sha256"},"source_id":{"title":"Source Id","type":"string"},"status":{"default":"FETCHED","title":"Status","type":"string"},"text_fingerprint":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Text Fingerprint"},"title":{"default":"","title":"Title","type":"string"},"url":{"title":"Url","type":"string"},"version":{"default":1,"title":"Version","type":"integer"}},"required":["id","source_id","url","content_hash","normalizer_version"],"title":"DocumentRecord (export schema 1.5)","type":"object","x-export-schema-version":"1.5","x-layout":"jsonl","x-snapshot-file":"documents.jsonl"}
