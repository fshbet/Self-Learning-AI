# Copy to .env and adjust. All settings are read via KP_* environment variables.

# --- Database (docker compose default) ---
KP_DATABASE_URL=postgresql+psycopg://kp:kp@localhost:5433/kp

# --- Object storage: "local" (filesystem, default) or "s3" (MinIO / R2 / S3) ---
KP_OBJECT_STORE=local
KP_LOCAL_STORE_PATH=./data/raw
# KP_S3_ENDPOINT=http://localhost:9000
# KP_S3_BUCKET=kp-raw
# KP_S3_ACCESS_KEY=kp
# KP_S3_SECRET_KEY=kp-secret-change-me

# --- LLM: env defaults; the Settings page can override these (stored in the database) ---
# providers: ollama | openai (any OpenAI-compatible endpoint) | anthropic
KP_LLM_PROVIDER=ollama
KP_OLLAMA_BASE_URL=http://localhost:11434
# KP_OPENAI_BASE_URL=https://api.openai.com/v1
# KP_OPENAI_API_KEY=
# KP_ANTHROPIC_BASE_URL=https://api.anthropic.com
# KP_ANTHROPIC_API_KEY=
# KP_SETTINGS_ALLOW_KEYS=true   # set false to forbid storing API keys in the local settings table
KP_LLM_MODEL_TRIAGE=qwen3:8b
KP_LLM_MODEL_EXTRACT=qwen3:8b
KP_LLM_MODEL_REASON=qwen3:8b

# --- Embeddings ---
KP_EMBEDDING_PROVIDER=ollama
KP_EMBEDDING_MODEL=nomic-embed-text
KP_EMBEDDING_DIMENSION=768

# --- Web search for discovery (optional; SearXNG via `docker compose --profile discovery up`) ---
KP_SEARCH_PROVIDER=searxng
KP_SEARXNG_URL=http://localhost:8080

# --- Collector ---
KP_USER_AGENT=KnowledgePlatformBot/0.1 (+mailto:you@example.com)
KP_CRAWL_DEFAULT_DELAY_SECONDS=1.5
KP_CRAWL_TIMEOUT_SECONDS=30

# --- Domains: extra directories containing domain plugins (comma separated) ---
KP_DOMAINS_PATH=./domains

# --- API / worker ---
KP_API_HOST=127.0.0.1
KP_API_PORT=8010
KP_EMBEDDED_WORKER=true
KP_LOG_LEVEL=INFO

# --- Self-evaluation ---
KP_EVAL_AFTER_PIPELINE=true
KP_EVAL_INTERVAL_HOURS=24
KP_EVAL_REGRESSION_THRESHOLD=0.05
